# Flask
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_SECRET_KEY=change-me-to-a-long-random-secret
FLASK_SESSION_SECURE=0

# Server
PORT=5000

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=kacooli_enp360
